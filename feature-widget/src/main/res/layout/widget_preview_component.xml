<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="SmallSp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/tasks_widget_description"
        android:textColor="#20242A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_preview_component_row"
        android:maxLines="2"
        android:padding="10dp"
        android:text="@string/component_widget_choose"
        android:textColor="#20242A"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
