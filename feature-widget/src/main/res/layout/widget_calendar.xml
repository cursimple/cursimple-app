<?xml version="1.0" encoding="utf-8"?>
<!--
  课程日历：标题栏是普通视图，网格画成一张图（CalendarWidgetRenderer），
  上面盖一层 6×7 的透明格子负责点击：周视图只用第一行（每列一天），月视图按实际周数显示行。
  格子的内边距由代码按图里节次栏、星期栏、图例的尺寸设置，和图对齐。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card">

    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_background_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66FFFFFF"
        android:text=""
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/calendar_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_bg_icon"
                android:contentDescription="@string/widget_page_prev"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_chevron_left" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/calendar_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#20242A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calendar_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#66707F"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 周视图的图例：只列这周真的出现的记号（事务圆点、考试红框、休、班），都没有时收起 -->
            <TextView
                android:id="@+id/calendar_legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical|start"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="#66707F"
                android:textSize="9.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/calendar_reset"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_bg_reset"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:textColor="#24527A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/calendar_mode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_bg_icon"
                android:gravity="center"
                android:minWidth="32dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="#4E5968"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/calendar_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_bg_icon"
                android:contentDescription="@string/widget_page_next"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_chevron_right" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/calendar_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <LinearLayout
