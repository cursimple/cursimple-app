<?xml version="1.0" encoding="utf-8"?>
<!-- 弹性：从顶部正中「弹」出来，先放大冲过头再回落，和滑入的直线下落一眼能分开 -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <scale
        android:duration="560"
        android:fromXScale="0.6"
        android:fromYScale="0.6"
        android:interpolator="@anim/class_notice_spring_overshoot"
        android:pivotX="50%"
        android:pivotY="0%"
        android:toXScale="1"
        android:toYScale="1" />
    <translate
        android:duration="560"
        android:fromYDelta="-40%"
        android:interpolator="@anim/class_notice_spring_overshoot"
        android:toYDelta="0" />
    <alpha
        android:duration="180"
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
