    <string name="permissions_overview_title">按需开启权限</string>
    <string name="permissions_overview_body">这里列出了各项权限的用途和当前状态。只开启你需要的项目，随时可以回来管理。</string>
    <string name="permissions_group_notifications">通知与显示</string>
    <string name="permissions_group_alarms">闹钟与后台</string>
    <string name="permissions_group_tools">日历、扫码与更新</string>
    <string name="permissions_notification_purpose">发送上课通知和闹钟通知。</string>
    <string name="permissions_overlay_purpose">仅用于你主动开启的自绘提醒横幅。</string>
    <string name="permissions_live_notification_purpose">让支持的设备在状态栏显示上课进度。</string>
    <string name="permissions_exact_alarm_purpose">让应用内闹钟在指定时间响起。</string>
    <string name="permissions_full_screen_purpose">允许闹钟在锁屏时显示全屏响铃界面。</string>
    <string name="permissions_battery_purpose">允许课简在后台继续运行，以便按时提醒。</string>
    <string name="permissions_dnd_purpose">供自动静音使用，允许切换静音或勿扰模式。</string>
    <string name="permissions_calendar_title">系统日历</string>
    <string name="permissions_calendar_purpose">读取可写入的日历，并在你同步时写入课程日程。</string>
    <string name="permissions_calendar_granted">已开启日历权限</string>
    <string name="permissions_action_grant">去授权</string>
    <string name="permissions_action_settings">去设置</string>
    <string name="permissions_action_manage">管理</string>
    <string name="permissions_action_description">%1$s，%2$s</string>
    <string name="permissions_request_use_settings">系统授权窗口无法再次打开，请点「去设置」手动授权。</string>
    <string name="permissions_declared_title">系统随安装提供</string>
    <string name="permissions_declared_body">联网、开机恢复、唤醒、振动、音频调节和前台服务由系统提供，可直接使用。</string>
    <string name="settings_replay_guide_subtitle">观看课表、导课和提醒的操作演示</string>
    <string name="permissions_shortcut_title">桌面快捷方式</string>
    <string name="permissions_shortcut_purpose">部分手机需要此权限，才能从课简把小组件添加到桌面。</string>
    <string name="permissions_background_restriction_title">系统后台限制</string>
    <string name="permissions_background_restriction_purpose">检查 Android 是否限制课简在后台运行。</string>
    <string name="permissions_background_restricted">已受限</string>
    <string name="permissions_background_unrestricted">未受限</string>
