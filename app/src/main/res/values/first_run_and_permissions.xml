<resources>
    <string name="guide_intro_title">快速认识课简</string>
    <string name="guide_grid_title">课表，一周一目了然</string>
    <string name="guide_grid_body">点开一门课，即可查看上课时间、地点、老师和周次。</string>
    <string name="guide_school_import_title">从教务系统导课</string>
    <string name="guide_school_import_body">在课表右上角点「＋」，找到「从教务系统导课」。搜索学校后，可以选择插件导入或通用导入。</string>
    <string name="guide_courses_title">管理课程和事务</string>
    <string name="guide_courses_body">在管理列表里搜索课程、老师或地点。长按条目可选中多项，集中处理。</string>
    <string name="guide_reminders_title">按需设置上课提醒</string>
    <string name="guide_reminders_body">打开侧边栏里的「提醒」，查看近期闹钟和上课通知。</string>
    <string name="guide_skip">跳过</string>
