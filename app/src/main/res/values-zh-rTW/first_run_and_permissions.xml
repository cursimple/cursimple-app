<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="guide_intro_title">快速認識課簡</string>
    <string name="guide_grid_title">課表，一週一目了然</string>
    <string name="guide_grid_body">點開一門課，即可查看上課時間、地點、老師和週次。</string>
    <string name="guide_school_import_title">從教務系統匯入課表</string>
    <string name="guide_school_import_body">在課表右上角點「＋」，找到「從教務系統匯入課表」。搜尋學校後，可以選擇外掛匯入或通用匯入。</string>
    <string name="guide_courses_title">管理課程和事務</string>
    <string name="guide_courses_body">在管理清單中搜尋課程、老師或地點。長按項目可選取多項，一次處理。</string>
    <string name="guide_reminders_title">依需求設定上課提醒</string>
    <string name="guide_reminders_body">開啟側邊欄的「提醒」，查看近期鬧鐘和上課通知。</string>
    <string name="guide_skip">略過</string>
    <string name="guide_previous">上一頁</string>
    <string name="guide_next">下一頁</string>
    <string name="guide_done">開始使用</string>
    <string name="guide_page_position">第 %1$d 頁，共 %2$d 頁</string>
    <string name="guide_animation_description">%1$s的操作示範</string>
    <string name="guide_continue_to_demo">繼續看操作示範</string>
    <string name="permissions_overview_title">依需求開啟權限</string>
    <string name="permissions_overview_body">這裡列出各項權限的用途和目前狀態。只開啟你需要的項目，隨時都能回來管理。</string>
    <string name="permissions_group_notifications">通知與顯示</string>
    <string name="permissions_group_alarms">鬧鐘與背景執行</string>
    <string name="permissions_group_tools">行事曆、掃碼與更新</string>
    <string name="permissions_notification_purpose">傳送上課通知和鬧鐘通知。</string>
    <string name="permissions_overlay_purpose">僅供你主動啟用的自訂提醒橫幅使用。</string>
    <string name="permissions_live_notification_purpose">在支援的裝置上，於狀態列顯示上課進度。</string>
    <string name="permissions_exact_alarm_purpose">讓應用程式內的鬧鐘在指定時間響起。</string>
    <string name="permissions_full_screen_purpose">允許鬧鐘在鎖定畫面顯示全螢幕響鈴畫面。</string>
    <string name="permissions_battery_purpose">允許課簡在背景繼續執行，以便準時提醒。</string>
    <string name="permissions_dnd_purpose">供自動靜音使用，允許切換靜音或勿擾模式。</string>
    <string name="permissions_calendar_title">系統行事曆</string>
    <string name="permissions_calendar_purpose">讀取可寫入的行事曆，並在你同步時寫入課程行程。</string>
    <string name="permissions_calendar_granted">已開啟行事曆權限</string>
    <string name="permissions_action_grant">前往授權</string>
    <string name="permissions_action_settings">前往設定</string>
    <string name="permissions_action_manage">管理</string>
    <string name="permissions_action_description">%1$s，%2$s</string>
    <string name="permissions_request_use_settings">系統授權視窗無法再次開啟，請點「前往設定」手動授權。</string>
    <string name="permissions_declared_title">系統隨安裝提供</string>
    <string name="permissions_declared_body">連線、開機恢復、喚醒、震動、音訊調節和前景服務由系統提供，可直接使用。</string>
    <string name="settings_replay_guide_subtitle">觀看課表、匯入與提醒的操作示範</string>
    <string name="permissions_shortcut_title">桌面捷徑</string>
    <string name="permissions_shortcut_purpose">部分手機需要此權限，才能從課簡將小工具加入桌面。</string>
    <string name="permissions_background_restriction_title">系統背景限制</string>
    <string name="permissions_background_restriction_purpose">查看 Android 是否限制課簡在背景執行。</string>
    <string name="permissions_background_restricted">已受限</string>
    <string name="permissions_background_unrestricted">未受限</string>
</resources>
