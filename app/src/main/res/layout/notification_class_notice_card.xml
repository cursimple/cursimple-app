<?xml version="1.0" encoding="utf-8"?>
<!--
  「品牌卡片」皮肤的内容区。

  只能用 RemoteViews 支持的那几种 View（LinearLayout / TextView / ImageView …），
  自定义 View、动画、模糊在这里都没有 API。Android 12 起系统还会在这块内容外面
  强行套一层它自己的头部，所以能换的只有这一块的底色、排版和图。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/class_notice_card_root"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_class_notice_card_green"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/class_notice_card_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_class_notice_logo_badge"
        android:padding="1dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher_foreground" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/class_notice_card_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/class_notice_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/class_notice_card_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
